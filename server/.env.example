# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co

# Use the service_role key here, not the anon key: the backend needs to
# read/write the tasks table regardless of Row Level Security policies.
# Keep it secret - it must never be sent to the browser/frontend.
SUPABASE_KEY=your-service-role-key

# Clerk (Dashboard -> API Keys). The SDK needs both keys server-side even
# though only the publishable key is meant for the browser. Keep this file
# secret regardless - CLERK_SECRET_KEY must never be exposed to the frontend.
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

PORT=4000
