# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co

# Use the service_role key here, not the anon key: the backend needs to
# read/write the tasks table regardless of Row Level Security policies.
# Keep it secret - it must never be sent to the browser/frontend.
SUPABASE_KEY=your-service-role-key

PORT=4000
